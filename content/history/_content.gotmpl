{{/*
  Builds a /history/<page>/ page for every content file listed in
  data/history.json (generated by scripts/gen-history.py). If the data file
  is missing, no history pages are built and the History tab links to GitHub.
*/}}
{{- with hugo.Data.history -}}
  {{- range $file, $commits := . -}}
    {{- $p := strings.TrimSuffix ".md" $file -}}
    {{- $p = strings.TrimSuffix "/_index" $p -}}
    {{- $p = strings.TrimSuffix "/index" $p -}}
    {{- if in (slice "_index" "index") $p }}{{ $p = "home" }}{{ end -}}
    {{- $.AddPage (dict
      "kind" "page"
      "path" $p
      "title" "History"
      "params" (dict "historyFile" $file "bookHidden" true "bookSearchExclude" true)
      "build" (dict "list" "never" "render" "always")
      "sitemap" (dict "disable" true)
      "layout" "history"
    ) -}}
  {{- end -}}
{{- end -}}
